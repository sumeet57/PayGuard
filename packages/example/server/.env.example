# --- LLM ---
OPENAI_API_KEY=your_openai_api_key

# --- Server ---
PORT=3000

# --- Default policy (frontend can adjust these live at runtime via /api/policy) ---
DEFAULT_MAX_TRANSACTION_AMOUNT=30000
DEFAULT_REQUIRE_APPROVAL_ABOVE=10000
